[Unit]
Description=DRHnet FastAPI backend
After=network.target postgresql.service
[Service]
Type=simple
WorkingDirectory=/opt/rh_app/backend
EnvironmentFile=/opt/rh_app/backend/.env
ExecStart=/opt/rh_app/backend/venv/bin/uvicorn main:app --host 127.0.0.1 --port 8000
Restart=always
User=root
[Install]
WantedBy=multi-user.target
