# Variables de entorno del backend DRHnet
# Copiar a `.env` y completar los valores. NUNCA subir `.env` al repositorio.

# --- SQL Server (datos principales de RR.HH.) ---
MSSQL_HOST=
MSSQL_PORT=1433
MSSQL_DB=ASSETS_RH
MSSQL_USER=
MSSQL_PASS=

# --- LDAP / Active Directory CUJAE ---
LDAP_SERVER=ldaps://<servidor>:636
LDAP_BASE_DN=dc=<dominio>,dc=<tld>
LDAP_USER_DN=
LDAP_PASSWORD=
LDAP_TIMEOUT=10
LDAP_DOMINIO=

# --- PostgreSQL del portal (usuarios, perfiles, tarifa horaria) ---
PG_HOST=127.0.0.1
PG_PORT=5432
PG_DB=rh_portal
PG_USER=rh_portal
PG_PASS=

# --- Sesión del portal ---
# Clave HMAC-SHA256 para firmar los tokens (cadena larga y aleatoria)
SESSION_SECRET=
SESSION_TTL_HOURS=8

# Carnés que conservan siempre el perfil de administrador (separados por coma)
ADMIN_CARNETS=

# Cuentas de servicio que pueden entrar sin ficha en la nómina (separadas por coma)
ACCESO_SIN_NOMINA=

# --- Pool de conexiones ---
DB_POOL_SIZE=8
DB_POOL_PREWARM=2
